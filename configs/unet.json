{
    "experiment": {
        "name": "unet_experiment",
        "seed": 42
    },

    "data": {
        "type": "tomopt",
        "path": "/path/to/data",

        "normalize_features": false,
        "in_memory": true,

        "batch_size": 32,
        "num_workers": 4,

        "split": {
            "type": "balanced_material_position",
            "random_seed": 32,

            "n_materials": 5,
            "n_positions": 49,

            "n_val_pos": 4,
            "n_test_pos": 4
        }
    },

    "model": {
        "type": "unet",

        "device": "cuda",

        "voxel_shape": [10, 10, 4],
        "radius": 0.1
    },

    "train": {
        "epochs": 100,

        "batch_size": 32,

        "optimizer": {
            "type": "adamw",
            "lr": 0.001,
            "weight_decay": 0.001
        },

        "scheduler": {
            "type": "reduce_on_plateau",
            "factor": 0.3,
            "patience": 3
        },

        "loss": {
            "type": "huber",
            "delta": 1.0
        },

        "early_stopping": {
            "enabled": true,
            "patience": 20,
            "min_delta": 1e-4,
            "monitor": "val_loss"
        },
        "checkpoint": {
            "save_best_only": true,
            "monitor": "val_loss"
        }
    }
}
